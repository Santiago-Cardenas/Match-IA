# Copia este archivo a .env (local) o cárgalo como variables de entorno en Render.
# Nunca subas claves reales a GitHub.

# Supabase (tu propio proyecto en supabase.com)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Las mismas dos, expuestas al navegador (se inyectan al hacer build)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key

# Google AI Studio (demo de texto e imagen)
GEMINI_API_KEY=
# Opcional: modelo de imagen (requiere plan con facturación)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Imágenes con Qwen-Image 2.1. IMAGE_PROVIDER = local | modelscope | gemini (vacío = automático:
# local si hay QWEN_IMAGE_URL, si no modelscope si hay MODELSCOPE_TOKEN, si no gemini)
IMAGE_PROVIDER=
# Tu PC con tools/qwen-image-server expuesto a internet (ngrok/cloudflared) y la clave compartida
QWEN_IMAGE_URL=
QWEN_IMAGE_TOKEN=
# API gratuita de ModelScope (alternativa en la nube, con cupo diario)
MODELSCOPE_TOKEN=
MODELSCOPE_IMAGE_MODEL=Qwen/Qwen-Image-2.1

# Clave para ver/exportar resultados en /resultados (elige una larga y no la compartas)
RESULTS_KEY=
